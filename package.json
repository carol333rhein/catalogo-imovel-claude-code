{
  "name": "catalogo-imovel-claude-code",
  "version": "1.0.0",
  "private": true,
  "description": "Molde de Reels de catálogo de imóvel folheado, preenchido pelo Claude Code",
  "scripts": {
    "render": "remotion render src/index.ts Reel out/catalogo-imovel.mp4 --gl=angle --timeout=300000",
    "quadro": "remotion still src/index.ts Reel out/quadro.png --gl=angle --timeout=300000 --frame=300"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/google-fonts": "4.0.527",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
